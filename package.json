{
  "name": "reclaim",
  "productName": "Reclaim",
  "version": "0.3.0",
  "description": "Чесний помічник для власника iPhone: офіційне відновлення Apple ID та доступу до пристрою",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ua.reclaim.app",
    "productName": "Reclaim",
    "files": [
      "main.js",
      "preload.js",
      "CHANGES.md",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Reclaim-setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reclaim"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
